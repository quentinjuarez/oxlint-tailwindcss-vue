{
  "jsPlugins": ["oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": [
        { "files": ["src/legacy/**/*.vue"], "use": "src/legacy.css" },
        { "files": ["src/**/*.vue", "src/**/*.ts"], "use": "src/style.css" }
      ]
    }
  },
  "rules": { "tailwindcss/no-unknown-classes": "error" }
}
